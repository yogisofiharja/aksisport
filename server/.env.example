PORT=8080
DATABASE_URL=postgres://aksi_user:PASSWORD@192.168.56.10:5432/aksi?sslmode=disable
FIREBASE_PROJECT_ID=your-firebase-project-id
ALLOWED_ORIGINS=*

# Account email (DP-015). Without RESEND_API_KEY, confirmation and reset
# codes are written to the server log instead of being emailed.
RESEND_API_KEY=
# Sender address on a domain verified in Resend, e.g.
# MAIL_FROM="Aksi <no-reply@aksisport.com>"
# Left empty, Resend's test sender is used, which only delivers to the
# Resend account owner's own address.
MAIL_FROM=

# Optional. Path to a Firebase service account key (JSON). Enables password
# recovery; without it, recovery reports itself unavailable.
FIREBASE_SERVICE_ACCOUNT_FILE=

# Rate limiting needs each visitor's real address. Behind Cloudflare + Caddy
# set CLIENT_IP_HEADER=CF-Connecting-IP; it is believed only from
# TRUSTED_PROXIES (default: the local Caddy). Leave both unset locally.
CLIENT_IP_HEADER=
TRUSTED_PROXIES=127.0.0.1,::1

# Matches may start this many minutes before a Session's start time
# (DP-022); starting one makes the Session In Progress early. Defaults to
# 10 — keep that in production. Raise it locally or on staging to test
# matches without waiting (e.g. 1440 = up to a day early).
MATCH_EARLY_START_MINUTES=10
