[Unit]
Description=AKSI API (production)
After=network.target postgresql.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/aksi-production/server
ExecStart=/opt/aksi-production/server/bin/aksi-server
EnvironmentFile=/etc/aksi/production.env
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
