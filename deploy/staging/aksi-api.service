[Unit]
Description=AKSI API (staging)
After=network.target postgresql.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/aksi-staging/server
ExecStart=/opt/aksi-staging/server/bin/aksi-server
EnvironmentFile=/etc/aksi/staging.env
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
